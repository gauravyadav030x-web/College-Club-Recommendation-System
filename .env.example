# College Club Recommendation System - Environment Configuration Example

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="College Club Recommendation System"
VERSION="1.0.0"

# Security (Replace with a strong random secret key in production)
SECRET_KEY="super-secret-key-change-in-production-2026-xyz-recommendation"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# For simple local development with SQLite:
DATABASE_URL="sqlite:///./college_clubs.db"

# For PostgreSQL production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_clubs_db"

# Recommendation Engine Multi-Factor Weights (Must sum to 1.0)
TFIDF_WEIGHT=0.50
OVERLAP_WEIGHT=0.35
GRAPH_WEIGHT=0.15

# Frontend Port
PORT=5173
VITE_API_URL="http://127.0.0.1:8000"
